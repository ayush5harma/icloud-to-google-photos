#!/usr/bin/env bash
# Google Photos for iPhone and iPad, running natively on this Apple silicon
# Mac, as the pipeline's uploader (PHOTOS_BACKEND=mac): fetch the IPA, verify
# it, convert and install it with ipa-install-on-mac, with ios/gp-bridge.m
# linked in. Zero taps, apart from the one sign-in this cannot do.
#
# MODES:  (no args) install or update      --check   report, change nothing
#         --ipa FILE  install this IPA instead of downloading GPHOTOS_IPA_URL
#                     (a one-off: unless its content is the pinned release,
#                     the login agent restores the pinned IPA on its next
#                     run -- change GPHOTOS_IPA_URL / GPHOTOS_IPA_SHA256 in
#                     the config to make a different IPA the one to keep)
#         --force     reinstall even when nothing changed
#
# WHAT THE IPA IS: Google Photos 7.92.0 with the Gunshot tweak's
# GunshotJailed.dylib injected (github.com/tqmane/gunshot, GPL-3.0), the
# tweak's own supported sideload shape. Its GoToHP engine uploads with the
# Pixel XL original-quality profile; the bridge feeds that engine from a
# folder (ios/gp-bridge.m has the contract). The app keeps the sandbox the
# converter gives every iOS app: its own container, the standard user folders
# (Pictures, Downloads, Movies, Music) and the devices an iOS app may ask for,
# each behind the usual macOS prompt.
#
# A REINSTALL KEEPS THE SIGN-IN: ipa-install-on-mac re-signs the bundle with a
# stable identity and its emulated keychain lives in the app's container, so
# an update of the IPA, the bridge or the converter keeps the account. Only
# --reset (never run from here) clears it.
#
# THE STAMP is the IPA's hash, the bridge source's hash and the converter's
# content; the install is repeated only when one of them moves. All three are
# known WITHOUT reading the cached IPA, which is why the cache is hashed only
# once an install is going to happen: the login agent asks this question at
# every login and the answer is almost always "nothing to do".

set -uo pipefail

LIB_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../lib"
# shellcheck disable=SC1091
. "$LIB_DIR/config.sh"
# shellcheck disable=SC1091
. "$LIB_DIR/log.sh"
# shellcheck disable=SC1091
. "$LIB_DIR/proc.sh"
ap_load_config
# For MAC_INBOX, the one definition of the folder the bridge watches.
# shellcheck disable=SC1091
. "$LIB_DIR/mac.sh"

BRIDGE_SRC="$LIB_DIR/../ios/gp-bridge.m"
LOG="$LOG_DIR/gphotos-mac-setup.log"
STAMP="$STATE_DIR/gphotos-mac.stamp"
IPA_CACHE="$STATE_DIR/GooglePhotos.ipa"
# The converter, when it is not on PATH: this revision of the public repo,
# fetched once into the state directory. Bump it with the flake input.
IPA_INSTALL_REPO="ayush5harma/ipa-install-on-mac"
IPA_INSTALL_REV="94601bc012a5e9eaf84861f2bedd3f9aa9a1537b"

CHECK=0; FORCE=0; IPA_FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK=1 ;;
    --force) FORCE=1 ;;
    --ipa) shift; IPA_FILE="${1:-}" ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  [ $# -gt 0 ] && shift
done
log_init "$LOG"
say() { log "$*"; printf '%s\n' "$*"; }
die() { say "ERROR: $*"; exit 1; }

# SINGLE INSTANCE, and its own lock rather than the caller's: the weekly setup
# agent and the login bootstrap agent can fire together, and two converters
# rewriting /Applications/GooglePhotos.app at once is how that bundle ends up
# neither the old app nor the new one. --check reads and installs nothing.
if [ "$CHECK" -eq 0 ]; then
  LOCK="$STATE_DIR/gphotos-mac-setup.lock"
  single_flight_lock "$LOCK" say
  case $? in
    1) say "another gphotos-mac-setup is running (pid $SFL_PID) — exiting"; exit 0 ;;
    2) die "cannot take lock $LOCK" ;;
  esac
  trap 'rm -rf "$LOCK"' EXIT
fi

[ "$(uname -m)" = arm64 ] || die "an iOS app runs only on an Apple silicon Mac; this one is $(uname -m) (PHOTOS_BACKEND=avd is the Intel path)"
[ -f "$BRIDGE_SRC" ] || die "bridge source missing: $BRIDGE_SRC"
# TEST THE THING, not a proxy for it: `xcrun --show-sdk-path` succeeds with the
# Command Line Tools alone, which carry no iOS-on-Mac SDK, so a CLT-only Mac
# used to sail past this guard and fail deep inside the converter, unattended,
# with the reason buried in a log.
[ -d "$(xcrun --sdk macosx --show-sdk-path 2>/dev/null)/System/iOSSupport" ] \
  || die "Xcode is needed: the Command Line Tools alone do not carry the iOS-on-Mac (Mac Catalyst) SDK the bridge is compiled against, so xcode-select --install is not enough"

# ── The converter ────────────────────────────────────────────────────────────
converter=""
if command -v "$IPA_INSTALL" >/dev/null 2>&1; then
  converter="$(command -v "$IPA_INSTALL")"
else
  fetched="$STATE_DIR/ipa-install-on-mac-$IPA_INSTALL_REV"
  if [ ! -x "$fetched/bin/ipa-install-on-mac" ]; then
    [ "$CHECK" -eq 1 ] && { say "converter: not installed (would fetch $IPA_INSTALL_REPO@${IPA_INSTALL_REV:0:7})"; }
    if [ "$CHECK" -eq 0 ]; then
      say "fetching ipa-install-on-mac ${IPA_INSTALL_REV:0:7}"
      tmp="$(mktemp -d)"
      curl -fsSL --retry 3 -o "$tmp/src.tgz" "https://github.com/$IPA_INSTALL_REPO/archive/$IPA_INSTALL_REV.tar.gz" \
        || die "could not download the converter"
      mkdir -p "$fetched" && tar -xzf "$tmp/src.tgz" -C "$fetched" --strip-components 1 || die "could not unpack the converter"
      rm -rf "$tmp"
    fi
  fi
  [ -x "$fetched/bin/ipa-install-on-mac" ] && converter="$fetched/bin/ipa-install-on-mac"
fi
# The converter's CONTENT, not a revision: an on-PATH converter (a Nix store
# symlink here) has no git to ask, and a stamp that never moved would leave the
# app on the old conversion after every converter bump. Its sibling lib/ counts
# too -- the entry point resolves its library from its own real path, so a bump
# that only touches lib/ changes the conversion while leaving bin/ byte-for-byte
# identical. Hashes only and never paths, so the same converter fetched into
# the state directory and installed on PATH stamp alike -- moving it is not a
# new conversion.
converter_hash() {  # <path to the converter>
  local real dir
  real="$(readlink -f "$1" 2>/dev/null || echo "$1")"
  dir="$(dirname "$real")/../lib"
  { shasum -a 256 "$real" | cut -c1-64
    [ -d "$dir" ] && find "$dir" -type f -exec shasum -a 256 {} + 2>/dev/null | cut -c1-64 | sort
    true
  } | shasum -a 256 | cut -c1-64
}
converter_rev=none
[ -n "$converter" ] && converter_rev="$(converter_hash "$converter")"

# ── What the install would be ────────────────────────────────────────────────
# WITHOUT READING THE CACHED IPA: the pinned hash is what an ordinary run
# installs, so "nothing to do" is decided from three cheap values and the 175 MB
# cache is hashed only below, once an install is actually going to happen. Only
# --ipa, an explicit one-off, has to hash the file it was handed.
ipa=""; ipa_sha=""
if [ -n "$IPA_FILE" ]; then
  [ -f "$IPA_FILE" ] || die "no such file: $IPA_FILE"
  ipa="$IPA_FILE"; ipa_sha="$(shasum -a 256 "$ipa" | cut -c1-64)"
fi
bridge_sha="$(shasum -a 256 "$BRIDGE_SRC" | cut -c1-64)"
# --ipa with the same content as the download stamps the same, so the login
# agent does not reinstall (and re-download) after a hand install.
want="$GPHOTOS_IPA_SHA256 $bridge_sha $converter_rev"
[ -n "$IPA_FILE" ] && [ "$ipa_sha" != "$GPHOTOS_IPA_SHA256" ] && want="$ipa_sha $bridge_sha $converter_rev"
have="$(cat "$STAMP" 2>/dev/null || true)"

installed=no; engine=unknown; bridge=unknown
if [ -d "$GPHOTOS_APP" ]; then
  installed=yes
  exe="$GPHOTOS_APP/$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$GPHOTOS_APP/Info.plist" 2>/dev/null || echo GooglePhotos)"
  links="$(otool -L "$exe" 2>/dev/null)"
  case "$links" in *GunshotJailed*) engine=yes ;; *) engine=no ;; esac
  case "$links" in *gp-bridge*) bridge=yes ;; *) bridge=no ;; esac
fi

if [ "$CHECK" -eq 1 ]; then
  # A report a human asked for is the one place the cache is worth hashing
  # whatever the answer, because "is the cached IPA the pinned one" is part of
  # what was asked.
  cached=none
  [ -f "$IPA_CACHE" ] && cached="$(shasum -a 256 "$IPA_CACHE" | cut -c1-64)"
  say "backend:      $PHOTOS_BACKEND"
  say "app:          $GPHOTOS_APP ($installed; GoToHP engine: $engine; folder bridge: $bridge)"
  say "IPA:          ${ipa:-$IPA_CACHE} (cached $cached; pinned $GPHOTOS_IPA_SHA256)"
  say "converter:    ${converter:-none}"
  say "up to date:   $([ "$installed" = yes ] && [ "$have" = "$want" ] && echo yes || echo no)"
  say "upload folder: $MAC_INBOX"
  exit 0
fi

if [ "$FORCE" -eq 0 ] && [ "$installed" = yes ] && [ "$have" = "$want" ]; then
  say "Google Photos is installed and current (IPA ${want:0:7}, bridge ${bridge_sha:0:7}, converter ${converter_rev:0:7})"
  exit 0
fi
[ -n "$converter" ] || die "no converter"

# An install IS going to happen, so now the cache is worth its 175 MB read: it
# stands in for the download only when it is byte-for-byte the pinned release.
if [ -z "$ipa" ] && [ -f "$IPA_CACHE" ] && [ "$(shasum -a 256 "$IPA_CACHE" | cut -c1-64)" = "$GPHOTOS_IPA_SHA256" ]; then
  ipa="$IPA_CACHE"; ipa_sha="$GPHOTOS_IPA_SHA256"
fi
if [ -z "$ipa" ]; then
  say "downloading Google Photos from $GPHOTOS_IPA_URL"
  tmp="$IPA_CACHE.part"
  curl -fL --retry 3 --progress-bar -o "$tmp" "$GPHOTOS_IPA_URL" || die "download failed"
  got="$(shasum -a 256 "$tmp" | cut -c1-64)"
  [ "$got" = "$GPHOTOS_IPA_SHA256" ] || { rm -f "$tmp"; die "the download's sha256 ($got) is not GPHOTOS_IPA_SHA256 ($GPHOTOS_IPA_SHA256): nothing installed"; }
  mv -f "$tmp" "$IPA_CACHE"; ipa="$IPA_CACHE"; ipa_sha="$got"
fi
# grep without -q: under pipefail a -q that exits on the first match leaves
# unzip with a broken pipe, and the pipeline reads as "no dylib".
/usr/bin/unzip -l "$ipa" 2>/dev/null | grep 'GunshotJailed.dylib' >/dev/null \
  || die "this IPA carries no GunshotJailed.dylib: without the Gunshot tweak's engine the app cannot upload from a folder"

# ── Install ──────────────────────────────────────────────────────────────────
# The app is not quit for the install: the converter replaces the bundle and
# the running process keeps its old mapping; the sync launches the new one at
# its next run once the old process exits. An install while Google Photos is
# uploading would lose that job, so refuse while the upload folder is busy.
busy=0
for f in "$MAC_INBOX"/*; do [ -f "$f" ] && { busy=1; break; }; done
if [ "$busy" -eq 1 ] && pgrep -f "^$GPHOTOS_APP/[^/]*$" >/dev/null 2>&1; then
  die "Google Photos is running with files in $MAC_INBOX: let it finish (or quit it) before reinstalling"
fi
say "installing Google Photos (${ipa_sha:0:7}) with the folder bridge, converter ${converter_rev:0:7}"
if ! "$converter" "$ipa" --dest "$(dirname "$GPHOTOS_APP")" --dylib "$BRIDGE_SRC" >>"$LOG" 2>&1; then
  die "ipa-install-on-mac failed; see $LOG"
fi
[ -d "$GPHOTOS_APP" ] || die "the converter finished but $GPHOTOS_APP does not exist (it names the app after the IPA's bundle: check $LOG for where it went)"
mkdir -p "$MAC_INBOX"
printf '%s\n' "$want" > "$STAMP"
# The pipeline's "setup finished" marker, which the login agent checks before
# it runs the setup again (avd-photos-setup --bootstrap), the same one the
# emulator path writes after its last phase.
date +%s > "$STATE_DIR/setup-complete"
say "installed $GPHOTOS_APP"
[ -n "$IPA_FILE" ] && [ "$ipa_sha" != "$GPHOTOS_IPA_SHA256" ] \
  && say "note: this IPA is not the pinned release; the login agent will reinstall the pinned one unless GPHOTOS_IPA_URL / GPHOTOS_IPA_SHA256 are changed in $CONFIG_FILE"
pgrep -f "^$GPHOTOS_APP/[^/]*$" >/dev/null 2>&1 && say "the previous copy is still running; quit it so the new one starts at the next sync"
say ""
say "ONE THING LEFT, once: open Google Photos and sign in to the Google account the photos should go to."
say "Then: avd-photos-arm"
