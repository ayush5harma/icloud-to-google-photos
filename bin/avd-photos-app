#!/usr/bin/env bash
# Build "Google Photos (AVD).app" -- a Dock-able macOS launcher that boots the
# rooted emulator if it is not already up, opens Google Photos inside it, and
# brings the emulator window forward.
#
# WHY AN .app AND NOT A SHELL ALIAS: only a bundle can sit in the Dock, carry an
# icon and be launched by click. Generated rather than committed so a fresh Mac
# builds it with nothing installed (the .icns is drawn from the Python stdlib),
# and idempotent, so a login agent can call it every time.
#
# The launcher shells out to `avd-photos-setup --start` rather than invoking the
# emulator: the launch flags (the GPU one above all) are load-bearing and must
# have exactly ONE definition, in boot_emulator.
#
#   avd-photos-app             build/refresh and pin it to the Dock
#   avd-photos-app --no-dock   build/refresh only
#   avd-photos-app --open      build/refresh, pin, and launch it

set -uo pipefail

SELF_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")"
LIB_DIR="$SELF_DIR/../lib"
# shellcheck disable=SC1091
. "$LIB_DIR/config.sh"
ap_load_config

APP_NAME="${AVD_APP_NAME:-Google Photos (AVD)}"
APP_DIR="${AVD_APP_DIR:-/Applications}/${APP_NAME}.app"
SETUP_BIN="$SELF_DIR/avd-photos-setup"

ap_seed_path "$AVD_SDK_ROOT/platform-tools"
mkdir -p "$APP_DIR/Contents/MacOS" "$APP_DIR/Contents/Resources" "$STATE_DIR"

say() { printf '  %s\n' "$*"; }

# ── Info.plist ───────────────────────────────────────────────────────────────
# LSUIElement stays absent: this is a real Dock app the user clicks.
cat >"$APP_DIR/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Google Photos (AVD)</string>
  <key>CFBundleDisplayName</key><string>Google Photos (AVD)</string>
  <key>CFBundleIdentifier</key><string>local.ayushsharma.avd-google-photos</string>
  <key>CFBundleExecutable</key><string>launch</string>
  <key>CFBundleIconFile</key><string>appicon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST

# ── launcher ─────────────────────────────────────────────────────────────────
# The three values this pipeline can move (the emulator name, the SDK root and
# where avd-photos-setup lives) are baked in at build time; everything else is a
# literal, so the body stays a quoted heredoc and needs no escaping.
{
  printf '#!/bin/bash\n'
  printf '# Boot the emulator if needed, open Google Photos in it, focus its window.\n'
  printf '# Generated by avd-photos-app -- edit that, not this.\n'
  printf 'AVD_NAME=%q\n' "$AVD_NAME"
  printf 'SDK_ROOT=%q\n' "$AVD_SDK_ROOT"
  printf 'SETUP=%q\n' "$SETUP_BIN"
  printf 'LOG=%q\n' "$LOG_DIR/launcher.log"
  cat <<'LAUNCH'
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$SDK_ROOT/platform-tools:/usr/bin:/bin:/usr/sbin:/sbin"
PKG="com.google.android.apps.photos"

# Which attached emulator IS ours: `adb emu avd name` answers "<name>\nOK".
# emulator-5554 is only the first free console port, so another emulator started
# earlier owns it, and this launcher would then bring a stranger's window
# forward and launch Photos inside it.
ours() {
  local s n
  for s in $(adb devices 2>/dev/null | awk '/^emulator-/ {print $1}'); do
    n="$(adb -s "$s" emu avd name 2>/dev/null | head -1 | tr -d '\r\n')"
    [ "$n" = "$AVD_NAME" ] && { printf '%s\n' "$s"; return 0; }
  done
  return 1
}
mkdir -p "$(dirname "$LOG")"
say() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }
notify() { osascript -e "display notification \"$1\" with title \"Google Photos (AVD)\"" >/dev/null 2>&1; }

if ! pgrep -f "qemu-system.*$AVD_NAME" >/dev/null 2>&1; then
  say "emulator not running — starting it"
  notify "Starting the emulator…"
  if [ ! -x "$SETUP" ]; then
    notify "avd-photos-setup is missing — re-run install.sh"; say "avd-photos-setup missing at $SETUP"; exit 1
  fi
  "$SETUP" --start >>"$LOG" 2>&1 || { notify "The emulator failed to start"; exit 1; }
fi

# Wait for our device to attach and answer before poking at it.
SER=""
for _ in $(seq 1 60); do
  SER="$(ours)" && [ -n "$SER" ] \
    && [ "$(adb -s "$SER" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ] && break
  SER=""; sleep 2
done
if [ -z "$SER" ]; then
  say "no attached emulator answers to the name $AVD_NAME"
  notify "The emulator did not come up"; exit 1
fi

adb -s "$SER" shell "monkey -p $PKG -c android.intent.category.LAUNCHER 1" >/dev/null 2>&1 \
  && say "launched $PKG on $SER" || { say "could not launch $PKG"; notify "Could not open Google Photos"; }

# Bring the emulator window to the front. The process is `qemu-system-...`, so
# activating by application NAME does not work; go via its pid.
EPID="$(pgrep -f "qemu-system.*$AVD_NAME" | head -1)"
[ -n "$EPID" ] && osascript -e "tell application \"System Events\" to set frontmost of (first process whose unix id is $EPID) to true" >/dev/null 2>&1
LAUNCH
} >"$APP_DIR/Contents/MacOS/launch"
chmod +x "$APP_DIR/Contents/MacOS/launch"
say "launcher written"

# ── icon ─────────────────────────────────────────────────────────────────────
# GENERATED, not extracted: the emulator's Photos.apk has every resource renamed
# by R8 (res/KF9.webp and friends) and its launcher icon is an adaptive XML with
# no square bitmap to pull. Drawn from the stdlib alone -- no PIL, no
# ImageMagick -- so a fresh Mac reproduces it with nothing installed.
#
# GEOMETRY: one canonical blade -- a half-disc of radius r centred at (cx, cy-r),
# clipped to x <= cx -- rotated by 90 degrees four times. That rotation makes the
# pinwheel; four circles or four pie slices both look wrong.
#
# LIGHT/DARK: an .icns holds ONE image, so the variant is chosen at build time
# and the bundle is rebuilt at every login. An appearance switch mid-session
# lands at the next login -- the honest trade for not authoring a .icon bundle.
build_icon() {
  local mode="light"
  [ "$(/usr/bin/defaults read -g AppleInterfaceStyle 2>/dev/null)" = "Dark" ] && mode="dark"
  local png="$STATE_DIR/appicon-$mode.png"
  python3 - "$png" "$mode" <<'PYICON' || return 1
import sys, zlib, struct, math
S=1024; out, mode = sys.argv[1], sys.argv[2]
cx=cy=S/2.0
PLATE=(255,255,255) if mode=="light" else (44,44,46)
R=S*0.40; n=5.0                                            # macOS squircle
# The squircle comes FIRST: macOS app icons fill ~824/1024, so R ~= 0.40*S. A
# blade's half-disc spans 2r from the centre, so the pinwheel's extent is 2r --
# size it against R, not against S, or the blades punch through the plate and the
# Dock shows a visibly CROPPED icon (which is exactly what 0.26*S did).
r=R*0.35
cols=[(251,188,4),(234,67,53),(66,133,244),(52,168,83)]   # clockwise from top-left
def blade(x,y,k):
    a=math.radians(-90*k); dx,dy=x-cx,y-cy
    u=cx+dx*math.cos(a)-dy*math.sin(a)
    v=cy+dx*math.sin(a)+dy*math.cos(a)
    return (u-cx)**2+(v-(cy-r))**2 <= r*r and u <= cx+0.5
rows=[]
for y in range(S):
    row=bytearray([0])
    for x in range(S):
        if (abs(x-cx)/R)**n + (abs(y-cy)/R)**n > 1.0:
            row+=bytes((0,0,0,0)); continue
        c=None
        for k in range(4):
            if blade(x,y,k): c=cols[k]; break
        if c is None: c=PLATE
        row+=bytes((c[0],c[1],c[2],255))
    rows.append(bytes(row))
raw=b"".join(rows)
def ch(t,d): return struct.pack(">I",len(d))+t+d+struct.pack(">I",zlib.crc32(t+d)&0xffffffff)
open(out,"wb").write(b"\x89PNG\r\n\x1a\n"
    + ch(b"IHDR",struct.pack(">IIBBBBB",S,S,8,6,0,0,0))
    + ch(b"IDAT",zlib.compress(raw,9)) + ch(b"IEND",b""))
PYICON
  [ -s "$png" ] || return 1
  local ico="$STATE_DIR/appicon.iconset"
  rm -rf "$ico"; mkdir -p "$ico"
  for sz in 16 32 64 128 256 512; do
    sips -s format png -z "$sz" "$sz" "$png" --out "$ico/icon_${sz}x${sz}.png" >/dev/null 2>&1
    sips -s format png -z "$((sz*2))" "$((sz*2))" "$png" --out "$ico/icon_${sz}x${sz}@2x.png" >/dev/null 2>&1
  done
  iconutil -c icns "$ico" -o "$APP_DIR/Contents/Resources/appicon.icns" >/dev/null 2>&1 || return 1
  say "icon generated ($mode)"
}
build_icon || say "icon generation failed — the app still works"

# Make Finder/Dock notice a changed bundle, and let Spotlight index it.
touch "$APP_DIR"
/usr/bin/xattr -cr "$APP_DIR" 2>/dev/null || true
/usr/bin/mdimport "$APP_DIR" >/dev/null 2>&1 || true
say "app ready: $APP_DIR"

# ── Dock ─────────────────────────────────────────────────────────────────────
pin_to_dock() {
  # DETECT BY file-label, NOT by path. `defaults` stores the tile URL
  # percent-encoded ("Google%20Photos%20(AVD).app"), so grepping for the plain
  # $APP_DIR never matches and every run appends another tile. The array is
  # rebuilt with python so any pre-existing duplicates collapse: -array-add can
  # only append, it cannot replace.
  python3 - "$APP_NAME" "$APP_DIR" <<'PYDOCK'
import subprocess, sys, plistlib
name, path = sys.argv[1], sys.argv[2]
try:
    raw = subprocess.run(["defaults","export","com.apple.dock","-"],
                         capture_output=True, check=True).stdout
    pl = plistlib.loads(raw)
except Exception as e:
    print(f"   could not read the Dock plist: {e}"); sys.exit(1)
apps = pl.get("persistent-apps", [])
kept = [t for t in apps if t.get("tile-data", {}).get("file-label") != name]
removed = len(apps) - len(kept)
tile = {"tile-data": {"file-data": {"_CFURLString": path, "_CFURLStringType": 0},
                      "file-label": name}, "tile-type": "file-tile"}
kept.append(tile)
print("   adding Dock tile" if removed == 0
      else "   refreshing Dock tile (removed %d existing)" % removed)
pl["persistent-apps"] = kept
try:
    subprocess.run(["defaults","import","com.apple.dock","-"],
                   input=plistlib.dumps(pl), check=True)
except Exception as e:
    print(f"   could not write the Dock plist: {e}"); sys.exit(1)
PYDOCK
  # The Dock only re-reads its plist on restart.
  /usr/bin/killall Dock 2>/dev/null
  say "Dock updated"
}
case "${1:-}" in
  --no-dock) say "skipping the Dock pin (--no-dock)" ;;
  *)         pin_to_dock ;;
esac

[ "${1:-}" = "--open" ] && open "$APP_DIR"
exit 0
