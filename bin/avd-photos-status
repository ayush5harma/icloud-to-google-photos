#!/usr/bin/env bash
# Emit ONE JSON blob describing the iCloud -> Google Photos pipeline. The menu
# bar app polls this every 30 seconds and paints its ring from it; a human can
# run it too (`avd-photos-status | jq`).
#
# IT COMPUTES ALMOST NOTHING. Every number that needs the Photos database, the
# ledger or a device query is WRITTEN BY THE SYNC JOB and only read here, with
# its age reported -- one writer, many readers. The two exceptions are cheap and
# need no root: counting the staging tree, and listing the camera folder when an
# emulator is ALREADY running. This never starts an emulator.
#
# FAST AND SILENT: a few stats and, at most, one bounded adb call.

set -uo pipefail

LIB_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../lib"
# shellcheck disable=SC1091
. "$LIB_DIR/config.sh"
# shellcheck disable=SC1091
. "$LIB_DIR/proc.sh"
ap_load_config
export LC_ALL=C   # bytewise sort/comm over staged paths, as in avd-photos-sync
# After the config: the Mac backend's paths are config keys.
# shellcheck disable=SC1091
. "$LIB_DIR/mac.sh"
ap_seed_path "$AVD_SDK_ROOT/platform-tools"

armed=false
[ -f "$SENTINEL" ] && armed=true
emu=false
[ "$PHOTOS_BACKEND" = avd ] && pgrep -f "qemu-system.*$AVD_NAME" >/dev/null 2>&1 && emu=true
# The Mac backend's device is the Google Photos app itself: running, and (from
# the bridge's heartbeat) whether it can upload right now and is signed in.
# "on_device" is what waits in its upload folder, the same slot the emulator's
# camera folder fills.
app=false; app_online=false; signed_in=false
if [ "$PHOTOS_BACKEND" = mac ]; then
  [ -n "$(mac_app_pid)" ] && app=true
  if mac_bridge_up; then
    [ "$(mac_alive online)" = true ] && app_online=true
    [ "$(mac_alive account)" = true ] && signed_in=true
  fi
fi

# Dotfiles excluded: a .DS_Store in the staging tree must not inflate the library
# count the sync ledger is compared against.
staged=0
[ -d "$STAGING" ] && staged="$(find "$STAGING" -type f ! -name '.*' 2>/dev/null | wc -l | tr -d ' ')"

ondev=0; uploaded=0; queued=0; failed=0; upl_age=-1; given_up=0
if [ "$PHOTOS_BACKEND" = mac ]; then
  ondev="$(mac_outstanding | mac_count)"
  # Failed MAC_RETRIES times: nothing retries them until a human runs
  # avd-photos-sync --retry-given-up, so they are their own number rather than
  # part of a backlog that would otherwise never go down.
  given_up="$(mac_given_up | mac_count)"
elif [ "$emu" = true ]; then
  # ASK WHICH SERIAL IS OURS rather than assuming 5554: another emulator on this
  # Mac would otherwise have its camera folder counted as this pipeline's
  # backlog. An emulator that is running but cannot be resolved (still booting,
  # or a wedged console) reports 0, which is what it is worth.
  ser="$(ap_emulator_serial "$AVD_NAME")"
  if [ -n "$ser" ]; then
    bounded() {
      local out; out="$(mktemp)"
      ( adb -s "$ser" shell "$@" >"$out" 2>/dev/null ) & local p=$! n=0
      while kill -0 "$p" 2>/dev/null; do
        [ "$n" -ge 6 ] && { kill -9 "$p" 2>/dev/null; break; }
        sleep 1; n=$((n+1))
      done
      wait "$p" 2>/dev/null; tr -d '\r' <"$out"; rm -f "$out"
    }
    # On-device count is cheap and needs no root: just list the camera folder.
    ondev="$(bounded "ls $DEST_DCIM 2>/dev/null | wc -l" | tr -dc '0-9')"
  fi
fi

# THE BACKLOG is staged files the ledger has not seen. `grep -c .` prints its own
# 0 on an empty file AND exits 1, so a `|| echo 0` would print a second 0 and
# break the JSON -- hence the `|| true` plus the ${x:-0} default below, and
# mac_count (lib/mac.sh) where the count comes off a pipe.
remaining=0
if [ "$PHOTOS_BACKEND" = mac ]; then
  if [ "${staged:-0}" -gt 0 ]; then
    handled_n="$(mac_handled | mac_count)"
    remaining=$(( staged - handled_n )); [ "$remaining" -lt 0 ] && remaining=0
  fi
elif [ "${staged:-0}" -gt 0 ] && [ -r "$STATE_DIR/pushed.list" ]; then
  pushed_n="$(grep -c . "$STATE_DIR/pushed.list" 2>/dev/null || true)"; pushed_n="${pushed_n:-0}"
  remaining=$(( staged - pushed_n ))
  [ "$remaining" -lt 0 ] && remaining=0
fi

# THE VERIFY COUNT DESCRIBES THE DEVICE AS OF ITS WRITE, and a push after it
# starts a batch it knows nothing about: read verbatim, a 05:47 status (1000 of
# 1000, then pruned) sat beside 377 freshly pushed files nine hours later and the
# bar read "1000/377" with an exclamation mark. So it counts only while its stamp
# is not older than the ledger's last change; otherwise the batch is unverified
# so far, and a verify pass in flight reports its own progress through the phase
# line parsed below.
if [ -r "$STATE_DIR/upload-status" ]; then
  read -r u t f ts _ < "$STATE_DIR/upload-status" 2>/dev/null || true
  led="$STATE_DIR/pushed.list"; [ "$PHOTOS_BACKEND" = mac ] && led="$MAC_STATE"
  led_m="$(stat -f %m "$led" 2>/dev/null || echo 0)"
  if [ "${ts:-0}" -ge "${led_m:-0}" ]; then
    uploaded="${u:-0}"; failed="${f:-0}"; queued="$(( ${t:-0} - ${u:-0} ))"
    [ "$queued" -lt 0 ] && queued=0
    [ -n "${ts:-}" ] && upl_age=$(( $(date +%s) - ts ))
  fi
fi

# THE CONFIRMATION STAMP IS THE ONLY HONEST "BACKED UP": the sync writes
# last-upload-confirmed only when every camera-folder file matched in
# remote_media with zero permanent failures, and DELETES it when a run cannot
# confirm. Every derived count above can look complete while that stamp is
# absent, so the app gates its green state on this and never on arithmetic.
confirmed=false; confirmed_age=-1
if [ -r "$STATE_DIR/last-upload-confirmed" ]; then
  cts="$(tr -dc '0-9' < "$STATE_DIR/last-upload-confirmed")"
  if [ -n "$cts" ]; then
    confirmed=true
    confirmed_age=$(( $(date +%s) - cts ))
    [ "$confirmed_age" -lt 0 ] && confirmed_age=0
  fi
fi

# PIPELINE LIVENESS is the age of the last COMPLETED run (the newest "done ("
# line), NOT the log's mtime: a run that bails writes the log too, so the mtime
# said "21.7h ago" and the meter said "All backed up" through five days of
# "icloudpd missing" skips. A healthy no-op still ends in "done (0 pushed this
# run)", so only a job that stopped completing goes stale.
last_run_age=-1
SYNC_LOG="$LOG_DIR/sync.log"
if [ -f "$SYNC_LOG" ]; then
  done_ts="$(grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} done \(' "$SYNC_LOG" 2>/dev/null | tail -1 | cut -c1-19)"
  lm=""
  [ -n "$done_ts" ] && lm="$(date -j -f '%Y-%m-%d %H:%M:%S' "$done_ts" +%s 2>/dev/null || echo)"
  [ -n "$lm" ] || lm="$(stat -f %m "$SYNC_LOG" 2>/dev/null || echo)"
  [ -n "$lm" ] && last_run_age=$(( $(date +%s) - lm ))
  [ "$last_run_age" -lt 0 ] && last_run_age=0
fi

# The reclaim ledgers: what has been deleted from iCloud after confirmation, and
# what is confirmed but not yet deleted.
reclaimed=0; reclaim_pending=0
[ -r "$STATE_DIR/reclaimed.list" ] && reclaimed="$(grep -c . "$STATE_DIR/reclaimed.list" 2>/dev/null || true)"
if [ -r "$STATE_DIR/reclaim-pending.list" ]; then
  reclaim_pending="$(sort -u "$STATE_DIR/reclaim-pending.list" | comm -23 - <(sort -u "$STATE_DIR/reclaimed.list" 2>/dev/null) | grep -c . || true)"
fi
reclaimed="${reclaimed:-0}"; reclaim_pending="${reclaim_pending:-0}"

# Two counts that say what the pipeline decided WITHOUT uploading or deleting:
# files Google Photos already had (lib/presence.sh) and assets the last reclaim
# kept in iCloud on purpose. The keep set carries one comment line, which is why
# this counts rows rather than lines.
present=0; kept=0
[ -r "$STATE_DIR/mac-present.tsv" ] && present="$(grep -c . "$STATE_DIR/mac-present.tsv" 2>/dev/null || true)"
[ -r "$STATE_DIR/keep-set.tsv" ] && kept="$(grep -cv '^#' "$STATE_DIR/keep-set.tsv" 2>/dev/null || true)"
present="${present:-0}"; kept="${kept:-0}"

# LIVE PHASE AND THE RUNNING FLAG come from the sync job itself: sync.lock/pid
# names the run in flight and $STATE_DIR/phase is its current step ("pushing 120
# of 500 to the emulator", "verifying uploads: 40 of 500 confirmed") or the
# "failed: <why>" it leaves behind. Read, never computed: a run is alive only
# while its pid is, so a crashed job cannot look busy.
running=false; phase=""
lp="$STATE_DIR/sync.lock/pid"
if [ -r "$lp" ]; then
  lpid="$(tr -dc '0-9' < "$lp")"
  [ -n "$lpid" ] && kill -0 "$lpid" 2>/dev/null && running=true
fi
[ -r "$STATE_DIR/phase" ] && phase="$(head -1 "$STATE_DIR/phase" | tr -d '"\\' | cut -c1-160)"
# The app's path travels in the JSON because the menu bar is the third reader of
# this config file and the only one that cannot source it: a launchd agent's
# environment holds PATH and nothing else, so an env read there was always the
# default (L5/B13 of the 2026-09-16 reviews). Escaped like phase.
app_path="$(printf '%s' "$GPHOTOS_APP" | tr -d '"\\')"
# A verify pass in flight publishes "verifying uploads: N of M confirmed" as its
# phase; while the run is alive that is the live count for the batch on the
# device (upload-status is written only after the pass ends).
if [ "$running" = true ]; then
  case "$phase" in
    "verifying uploads: "*" of "*" confirmed")
      v="${phase#verifying uploads: }"; vu="${v%% of *}"; vt="${v#* of }"; vt="${vt%% confirmed*}"
      case "$vu$vt" in
        ''|*[!0-9]*) ;;
        *) uploaded="$vu"; queued=$(( vt - vu )); [ "$queued" -lt 0 ] && queued=0; upl_age=0 ;;
      esac ;;
  esac
fi

# THE MESSAGES SOURCE, reported on its own because the menu shows it on its own
# rows: a skipped Messages scan says nothing about the photo sync, and "needs
# Full Disk Access" must not hide inside a photo-sync status. Read from the
# line msg_scan (lib/messages.sh) replaces on every scan, never from the log.
# The CONFIG decides "off" -- a line left by an earlier, enabled run is not a
# source that still runs -- and a line that does not parse is "unknown", as is
# an enabled source that has not scanned yet: neither is an observation.
msg_state=off; msg_reason=""; msg_count=0; msg_age=-1
if [ "${MESSAGES_SOURCE:-0}" = 1 ]; then
  msg_state=unknown
  if [ -r "$STATE_DIR/messages-status" ]; then
    IFS="$(printf '\t')" read -r m_ts m_state m_count m_reason < "$STATE_DIR/messages-status" 2>/dev/null || true
    case "${m_ts:-x}${m_count:-x}" in
      *[!0-9]*) ;;
      *)
        case "${m_state:-}" in
          ok|skipped)
            msg_state="$m_state"; msg_count="$m_count"
            msg_age=$(( $(date +%s) - m_ts )); [ "$msg_age" -lt 0 ] && msg_age=0
            msg_reason="$(printf '%s' "${m_reason:-}" | tr -d '"\\' | tr -d '\000-\037' | cut -c1-160)" ;;
        esac ;;
    esac
  fi
fi

printf '{"backup":{"armed":%s,"backend":"%s","app":%s,"app_online":%s,"signed_in":%s,"app_path":"%s","emulator":%s,"staged":%s,"remaining":%s,"on_device":%s,"given_up":%s,"uploaded":%s,"queued":%s,"failed":%s,"upload_age":%s,"confirmed":%s,"confirmed_age":%s,"last_run_age":%s,"running":%s,"phase":"%s","reclaimed":%s,"reclaim_pending":%s,"present":%s,"kept":%s},"messages":{"state":"%s","reason":"%s","count":%s,"age":%s},"ts":%s}\n' \
  "$armed" "$PHOTOS_BACKEND" "$app" "$app_online" "$signed_in" "$app_path" "$emu" "${staged:-0}" "${remaining:-0}" "${ondev:-0}" "${given_up:-0}" "${uploaded:-0}" "${queued:-0}" "${failed:-0}" "${upl_age:--1}" "$confirmed" "$confirmed_age" "$last_run_age" "$running" "$phase" "$reclaimed" "$reclaim_pending" "$present" "$kept" \
  "$msg_state" "$msg_reason" "$msg_count" "$msg_age" "$(date +%s)"
