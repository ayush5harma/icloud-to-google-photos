#!/usr/bin/env bash
# Boot the emulator and leave it running. NEVER hand-type
# `emulator -avd <name>`: the launch flags are load-bearing and fail SILENTLY
# when missing (the GPU one above all). boot_emulator owns them; this reuses it.
exec "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/avd-photos-setup" --start "$@"
