<?xml version="1.0" encoding="utf-8"?>
<!--
  The flyout a click on the tray icon opens: the macOS dropdown's content as a
  Windows 11 flyout. A conclusion line, the ledger, and the actions that are
  safe to take by hand. The rows and the actions are built in code-behind,
  because which ones exist depends on the pipeline's state.
-->
<Window
    x:Class="PhotoSync.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Photo Sync">

    <!-- Top-aligned so the root sizes to its CONTENT, and the window follows it
         (FlyoutWindow.Place); stretched, it would report the window's size. -->
    <Grid x:Name="Root" Width="360" Padding="16,16,16,10" RowSpacing="12" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The ring and the one-line conclusion. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="RingImage" Width="36" Height="36" VerticalAlignment="Top" Margin="0,1,0,0" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="iCloud → Google Photos" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="Headline" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" MaxLines="3" />
            </StackPanel>
        </Grid>

        <!-- Warnings that are not the headline: dormant, not installed. -->
        <StackPanel x:Name="Notes" Grid.Row="1" Spacing="8" />

        <!-- The ledger. -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid x:Name="Ledger" ColumnSpacing="16" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>

        <!-- The actions. -->
        <StackPanel x:Name="Actions" Grid.Row="3" Spacing="6" />

        <!-- Freshness, and the housekeeping. -->
        <Grid Grid.Row="4">
            <TextBlock x:Name="Footer" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                <Button x:Name="RefreshButton" ToolTipService.ToolTip="Refresh now" Background="Transparent" BorderThickness="0" Padding="8,6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button x:Name="LogsButton" ToolTipService.ToolTip="Open the logs folder" Background="Transparent" BorderThickness="0" Padding="8,6">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                </Button>
                <Button x:Name="QuitButton" ToolTipService.ToolTip="Quit Photo Sync" Background="Transparent" BorderThickness="0" Padding="8,6">
                    <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
