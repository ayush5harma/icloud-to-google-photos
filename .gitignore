# Build artefacts. The app is built into /Applications (or --dest), never into
# the checkout, so the only thing a build leaves here is its failure log.
.build.log
*.icon/
*.iconset/

# The Windows tray app's build output; windows\build.ps1 publishes into
# %LOCALAPPDATA%\Programs\Photo Sync, never into the checkout.
windows/PhotoSync/bin/
windows/PhotoSync/obj/

# macOS
.DS_Store

# Python bytecode from `python3 -m py_compile`
__pycache__/
*.pyc
